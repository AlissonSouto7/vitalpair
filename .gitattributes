# Normalize every text file to LF in the repository. Without this, checkouts on
# Windows store CRLF and every diff reports "LF will be replaced by CRLF".
* text=auto eol=lf

# Files that must keep CRLF to run on Windows.
*.cmd text eol=crlf
*.bat text eol=crlf

# Files that must keep LF regardless of platform.
mvnw text eol=lf
*.sh text eol=lf

# Binaries: never touch, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.jar binary
*.zip binary

# Generated or vendored files: keep them out of diffs and language stats.
frontend/package-lock.json linguist-generated=true -diff
.mvn/wrapper/** linguist-vendored=true
docs/** linguist-documentation=true
