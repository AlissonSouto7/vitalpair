# VitalPair — modelo de variáveis de ambiente.
# Copie para .env e preencha. O arquivo .env NÃO é versionado (ver .gitignore).
# Em desenvolvimento, o profile "dev" já traz defaults; estas variáveis sobrescrevem quando definidas.

# ---- Servidor ----
# O profile dev sobe na 8081 para não conflitar com outros serviços locais na 8080.
SERVER_PORT=8081

# ---- Banco de dados (PostgreSQL) ----
DATABASE_URL=jdbc:postgresql://localhost:5432/vitalpair
DATABASE_NAME=vitalpair
DATABASE_USER=vitalpair
DATABASE_PASSWORD=troque-esta-senha

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Portas do host para o docker compose (úteis se 5432/6379 já estiverem em uso) ----
VITALPAIR_DB_PORT=5432
VITALPAIR_REDIS_PORT=6379

# ---- JWT (mínimo 32 caracteres / 256 bits) ----
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# ---- CORS ----
FRONTEND_URL=http://localhost:5173

# ---- OAuth2 Google (Fase 2 — do Google Cloud Console) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- IA (planos e análise de foto) ----
# Sem a chave, os endpoints de IA respondem 503 com mensagem amigável em vez de quebrar.
ANTHROPIC_API_KEY=
# Opcional: sobrescreve o modelo usado. O default está no application.yaml.
ANTHROPIC_MODEL=

# ---- Open Food Facts ----
OPEN_FOOD_FACTS_USER_AGENT=VitalPair/1.0 (seu@email.com)

# ---- E-mail (SMTP) — recuperação de senha e confirmação de conta ----
# Em dev, use o Mailpit que sobe no docker compose: os e-mails ficam em
# http://localhost:8025 e nada é enviado pra fora. Basta manter os valores abaixo.
#
# O link NUNCA é escrito no log: ele carrega um token de uso único que dá acesso à
# conta, e log é lido, arquivado e enviado pra ferramentas. Com MAIL_ENABLED=false o
# e-mail simplesmente não é enviado e o fluxo não dá pra testar.
#
# Para enviar de verdade (ex.: Gmail com "senha de app"): troque host/porta e preencha
# SPRING_MAIL_USERNAME e SPRING_MAIL_PASSWORD.
MAIL_ENABLED=true
MAIL_FROM=VitalPair <no-reply@vitalpair.app>
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Mailpit não pede autenticação nem TLS. Com um provedor real, ambos vão para true.
SPRING_MAIL_AUTH=false
SPRING_MAIL_STARTTLS=false
