# VitaPair — modelo de variáveis de ambiente.
# Copie para .env e preencha. O arquivo .env NÃO é versionado (ver .gitignore).
# Em desenvolvimento, o profile "dev" já traz defaults; estas variáveis sobrescrevem quando definidas.

# ---- Banco de dados (PostgreSQL) ----
DATABASE_URL=jdbc:postgresql://localhost:5432/vitapair
DATABASE_NAME=vitapair
DATABASE_USER=vitapair
DATABASE_PASSWORD=troque-esta-senha

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Portas do host para o docker compose (úteis se 5432/6379 já estiverem em uso) ----
VITAPAIR_DB_PORT=5432
VITAPAIR_REDIS_PORT=6379

# ---- JWT (mínimo 32 caracteres / 256 bits) ----
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# ---- CORS ----
FRONTEND_URL=http://localhost:5173

# ---- OAuth2 Google (Fase 2 — do Google Cloud Console) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- IA (geração de planos — Fase 2) ----
ANTHROPIC_API_KEY=

# ---- Open Food Facts ----
OPEN_FOOD_FACTS_USER_AGENT=VitaPair/1.0 (seu@email.com)
