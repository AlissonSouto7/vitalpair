# VitalPair — modelo de variáveis de ambiente.
# Copie para .env e preencha. O arquivo .env NÃO é versionado (ver .gitignore).
# Em desenvolvimento, o profile "dev" já traz defaults; estas variáveis sobrescrevem quando definidas.

# ---- Servidor ----
# O profile dev sobe na 8081 para não conflitar com outros serviços locais na 8080.
SERVER_PORT=8081

# ---- Banco de dados (PostgreSQL) ----
DATABASE_URL=jdbc:postgresql://localhost:5432/vitalpair
DATABASE_NAME=vitalpair
DATABASE_USER=vitalpair
DATABASE_PASSWORD=troque-esta-senha

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Portas do host para o docker compose (úteis se 5432/6379 já estiverem em uso) ----
VITALPAIR_DB_PORT=5432
VITALPAIR_REDIS_PORT=6379

# ---- JWT (mínimo 32 caracteres / 256 bits) ----
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# ---- Frontend / CORS ----
# URL pública do frontend: monta os links de e-mail (redefinição de senha, confirmação).
FRONTEND_URL=http://localhost:5173
# Origens que podem chamar a API pelo navegador, separadas por vírgula. Se vazio, usa a
# FRONTEND_URL. Precisa incluir a URL de qualquer túnel (ngrok etc.) usado pra demonstrar o app.
#
# A 4173 é o servidor de preview, que serve o build de produção e é contra ela que os testes
# de navegador (Playwright) rodam. Sem ela na lista, todo pedido do teste volta 403.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- Sign-in with Google (client id from the Google Cloud Console; public by design) ----
GOOGLE_CLIENT_ID=

# ---- IA (planos e análise de foto) ----
# Sem a chave, os endpoints de IA respondem 503 com mensagem amigável em vez de quebrar.
ANTHROPIC_API_KEY=
# Opcional: sobrescreve o modelo usado. O default está no application.yaml.
ANTHROPIC_MODEL=

# ---- Open Food Facts ----
OPEN_FOOD_FACTS_USER_AGENT=VitalPair/1.0 (seu@email.com)

# ---- E-mail (SMTP) — recuperação de senha e confirmação de conta ----
# Em dev, use o Mailpit que sobe no docker compose: os e-mails ficam em
# http://localhost:8025 e nada é enviado pra fora. Basta manter os valores abaixo.
#
# O link NUNCA é escrito no log: ele carrega um token de uso único que dá acesso à
# conta, e log é lido, arquivado e enviado pra ferramentas. Com MAIL_ENABLED=false o
# e-mail simplesmente não é enviado e o fluxo não dá pra testar.
#
# Para enviar de verdade (ex.: Gmail com "senha de app"): troque host/porta e preencha
# SPRING_MAIL_USERNAME e SPRING_MAIL_PASSWORD.
MAIL_ENABLED=true
MAIL_FROM=VitalPair <no-reply@vitalpair.app>
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Mailpit não pede autenticação nem TLS. Com um provedor real, ambos vão para true.
SPRING_MAIL_AUTH=false
SPRING_MAIL_STARTTLS=false

# ===== OBSERVABILIDADE E AGENDAMENTO =====
# Porta das rotas operacionais (health, info, prometheus). Fica separada da API de propósito:
# publicar a API na internet não deve publicar uma leitura ao vivo do sistema junto. Em
# produção esta porta não é mapeada pelo nginx.
MANAGEMENT_PORT=9090

# Fuso dos jobs agendados. O servidor normalmente roda em UTC, o que dispararia a missão
# das 09:00 às 06:00 no horário de Brasília.
SCHEDULING_ZONE=America/Sao_Paulo

# Quanto tempo vale cada link enviado por e-mail, em milissegundos. O de senha é curto de
# propósito: quem pede redefinição está com a caixa aberta na mão. O de verificação de conta
# é longo porque a pessoa pode confirmar o e-mail no dia seguinte sem perder a conta.
PASSWORD_RESET_TTL_MS=1800000
EMAIL_VERIFICATION_TTL_MS=86400000

# Nível de log só do código do projeto (as bibliotecas seguem o padrão do Spring). DEBUG
# aqui mostra cada chamada de caso de uso; em produção fica INFO.
LOG_LEVEL=INFO

# Swagger e /v3/api-docs no perfil de produção. Falso por padrão: a documentação da API
# descreve cada endpoint e cada payload. Staging roda o mesmo perfil e liga isto, com o
# nginx de borda pedindo senha antes de chegar na aplicação.
SWAGGER_ENABLED=false
FLASH_MISSION_CRON=0 0 9 * * *
LOG_REMINDER_CRON=0 0 20 * * *
