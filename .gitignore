### VitalPair ###
# Environment files hold secrets and are never versioned. See .env.example.
.env
.env.*
!.env.example
# Local AI session context (notes, worklog, local settings). Never versioned.
.claude/
# Phase plans rendered for the owner; the editable source lives in .claude/notes.
docs/planos/
# Logs
*.log
logs/

### Node (repository tooling: husky, commitlint, prettier) ###
node_modules/
# Husky's own generated helper; the hooks themselves are committed.
.husky/_/

# Filled-in environment files live only on the machine: they hold the database password,
# the JWT secret and the AI key. Only the .example versions are committed.
deploy/env/*.env
!deploy/env/*.env.example
deploy/env/.deployed-*
deploy/env/.previous-*
# Basic-auth credentials for the staging extras, written by deploy/scripts/htpasswd.sh.
deploy/env/htpasswd
