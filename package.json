{
  "name": "vitalpair-tooling",
  "private": true,
  "type": "module",
  "description": "Repository-level tooling: git hooks, commit message linting and formatting. The application lives in frontend/ and src/.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2"
  }
}
