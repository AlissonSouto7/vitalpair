root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
indent_size = 4
max_line_length = 120

[*.{ts,tsx,js,jsx,mjs,cjs,css,scss,html,json,jsonc,yml,yaml,xml,sql}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab
