# Staging. Copy to staging.env on the machine and fill in; that file is never committed.
#
# Generate each secret rather than inventing one:
#   openssl rand -base64 48

ENVIRONMENT=staging

# The address people type. E-mail links are built from it and it is the only origin the
# browser is allowed to call the API from, so it must match exactly, scheme included.
PUBLIC_URL=https://staging.example.com

# ---- database ----
DATABASE_NAME=vitalpair
DATABASE_USER=vitalpair
DATABASE_PASSWORD=

# ---- cache and tokens ----
REDIS_PASSWORD=

# ---- authentication ----
# At least 32 characters: HS256 needs 256 bits, and the application refuses to start with
# less rather than signing tokens with a weak key.
JWT_SECRET=

# ---- e-mail ----
# With MAIL_ENABLED=false the verification and password-reset flows cannot be completed,
# because the link is never delivered. Staging usually wants a real provider or a catch-all
# inbox.
MAIL_ENABLED=false
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=VitalPair <no-reply@example.com>

# ---- integrations ----
GOOGLE_CLIENT_ID=
# Without a key the AI features answer 503 with a friendly message rather than failing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ---- images ----
# Set by the deploy script; these are only the fallback for building locally.
BACKEND_IMAGE=vitalpair-backend:local
FRONTEND_IMAGE=vitalpair-frontend:local

# ---- limits ----
# Sized for a machine with 4 GB. The sum must leave room for the operating system and the
# proxy, or the kernel starts killing containers under load.
POSTGRES_MEM_LIMIT=512m
REDIS_MEM_LIMIT=256m
BACKEND_MEM_LIMIT=768m
FRONTEND_MEM_LIMIT=128m

# ===== Monitoramento (deploy/compose.monitoring.yaml, só staging) =====
# Sem valor padrão de propósito: o stack recusa subir sem senha, porque Grafana com
# admin/admin exposto é como a máquina é tomada.
GRAFANA_ADMIN_PASSWORD=
# Grafana é servido sob um caminho pelo proxy, então precisa saber a própria raiz ou os
# links que ele renderiza apontam pro lugar errado.
GRAFANA_ROOT_URL=https://staging.vitalpair.app/grafana/
PROMETHEUS_RETENTION=15d
PROMETHEUS_MEM_LIMIT=256m
GRAFANA_MEM_LIMIT=256m
