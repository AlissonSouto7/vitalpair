# The edge proxy: one per machine, in front of every environment.
# Copy to edge.env on the machine.

# The domain the certificate is issued for and that nginx answers on.
SERVER_NAME=staging.example.com

# Which application stack this proxy routes to: it resolves backend-<environment> and
# frontend-<environment> on the shared network.
ENVIRONMENT=staging

NGINX_MEM_LIMIT=128m
