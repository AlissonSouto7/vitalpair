# The edge proxy: one per machine, in front of every environment.
# Copy to edge.env on the machine.

# The names this machine answers on, one per environment it serves. Leave one empty and
# that environment does not exist here: no site, no certificate needed. Each name that is
# set needs a certificate in the edge's volume, issued by scripts/certbot-init.sh (or by
# scripts/selfsigned.sh, for a rehearsal without a domain).
STAGING_SERVER_NAME=staging.example.com
PRODUCTION_SERVER_NAME=

# Other names that answer for a site and redirect to its canonical one, space separated.
# Production is the bare domain, so www. in front of it has to arrive somewhere: a name
# that resolves and then refuses is worse than one that does not resolve at all. The
# certificate has to cover these names too, because the redirect itself is served over
# https. Leave empty and no alias server is rendered.
#PRODUCTION_SERVER_ALIASES=www.example.com
#STAGING_SERVER_ALIASES=

NGINX_MEM_LIMIT=128m

# Only for a rehearsal on a developer machine where 80 and 443 are already taken.
#EDGE_HTTP_PORT=18080
#EDGE_HTTPS_PORT=18443
