# Production. Copy to production.env on the machine and fill in; that file is never committed.
#
# Generate each secret rather than inventing one:
#   openssl rand -base64 48

ENVIRONMENT=production

# The address people type. E-mail links are built from it and it is the only origin the
# browser is allowed to call the API from, so it must match exactly, scheme included.
PUBLIC_URL=https://example.com

# ---- database ----
DATABASE_NAME=vitalpair
DATABASE_USER=vitalpair
DATABASE_PASSWORD=

# ---- cache and tokens ----
REDIS_PASSWORD=

# ---- authentication ----
# At least 32 characters: HS256 needs 256 bits, and the application refuses to start with
# less rather than signing tokens with a weak key.
JWT_SECRET=

# ---- e-mail ----
# Production must send mail: without it nobody can verify an address or reset a password.
MAIL_ENABLED=true
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=VitalPair <no-reply@example.com>

# ---- integrations ----
# Used twice: the backend verifies the token with it, and it is baked into the frontend
# bundle at build time (the browser needs it). Because it is a build argument, changing it
# means rebuilding the frontend image, not just restarting the container. The address of
# this environment has to be listed under "Authorized JavaScript origins" in the Google
# console, or the button refuses to load. Empty hides the button.
GOOGLE_CLIENT_ID=
# Without a key the AI features answer 503 with a friendly message rather than failing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ---- API documentation ----
# Never in production: the interactive API browser is a complete map of every endpoint and
# payload shape. The edge answers 404 on its paths here regardless of this value.
SWAGGER_ENABLED=false

# ---- images ----
# Set by the deploy script; these are only the fallback for building locally.
BACKEND_IMAGE=vitalpair-backend:local
FRONTEND_IMAGE=vitalpair-frontend:local

# ---- limits ----
# Sized for a machine with 4 GB, with production given more than staging. The sum must
# leave room for the operating system and the proxy, or the kernel starts killing
# containers under load.
POSTGRES_MEM_LIMIT=1g
REDIS_MEM_LIMIT=256m
BACKEND_MEM_LIMIT=1g
FRONTEND_MEM_LIMIT=128m
